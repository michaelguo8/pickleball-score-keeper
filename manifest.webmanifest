{
  "name": "Pickleball Score Keeper",
  "short_name": "PB Score",
  "description": "Simple rally-scoring singles pickleball scorekeeper. Works offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f1720",
